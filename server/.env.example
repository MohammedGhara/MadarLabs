# Port for the Express API (default 3001)
PORT=3001

# Where lead emails are delivered (inbox that receives contact form submissions)
RECIPIENT_EMAIL=madarlabs0@gmail.com

# Gmail account used to send mail (usually the same workspace inbox)
GMAIL_USER=madarlabs0@gmail.com

# Gmail App Password (not your normal password) — https://support.google.com/accounts/answer/185833
# Paste the 16 characters with or without spaces; the server strips spaces.
GMAIL_APP_PASSWORD=

# Optional: use Resend instead of Gmail (https://resend.com). If set, it takes priority over Gmail.
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=MadarLabs <onboarding@resend.dev>
